{
  // SLOW TRAIN COMING BACK - blues shuffle.
  //
  // The one preset that needed the engine changing. Everything else Ghostband
  // plays sits on a straight grid; a twelve bar on a straight grid is not a
  // twelve bar, it is a rock song with the wrong chords. So the whole
  // performance is warped: the offbeats are pushed two thirds of the way
  // through each beat and the downbeats stay put.
  //
  // "swing" defaults to 0.62 for this style, which is a hard shuffle without
  // being a full triplet. Set it to 1.0 for a lazy Texas feel or 0.4 for
  // something closer to a jump blues.
  //
  // The bass is on eighths everywhere rather than roots. Roots gives one note a
  // bar, which in any other style reads as restraint and here just reads as a
  // drone - a blues bass walks. Over a shuffle those eighths come out as the
  // boogie, which is the engine of the whole thing.
  //
  // Every chord is a dominant seventh, and that is not a flourish - it is the
  // difference between a blues and a folk song with a shuffle on it. A twelve
  // bar in A is A7, D7, E7: the flat seventh sitting on a major third is the
  // sound itself. Written as plain triads this preset had the right shape, the
  // right feel and the wrong harmony, which is exactly what it sounded like.
  //
  // Mixolydian for the same reason, so the melody agrees with the chords.

  "title": "Slow Train Coming Back",

  "key":  "A",
  "mode": "mixolydian",
  // ---- WHERE THE SECOND GUITAR ANSWERS ----
  //
  // All three verses. Call and response is not decoration in a blues, it is the
  // form: the singer states a line, an instrument answers it, and the answer is
  // as much a part of the tune as the line. So guitar2 fills through verse1,
  // verse2 and verse3 while the piano leads them.
  //
  // Silent in three places. The intro and breakdown have no guitar2 in their
  // "plays" at all - both are piano and rhythm section by design - and the
  // ending is open chords left to ring, which is the one gesture an answering
  // phrase would spoil.

  "bpm":  86,
  "time_signature": [4, 4],

  "style":       "blues",
  "bass_tuning": "standard",
  "play_style":  "pick",

  "swing":      0.62,
  "complexity": 0.45,
  "humanize":   0.78,
  "seed":       1936,
  "ending":     "ritard",

  "drum_profile":   "profiles/ssd5-terry-date.json",
  "bass_profile":   "profiles/modo-bass-2.json",
  "guitar_profile": "profiles/vg-iron2.json",
  "guitar2_profile": "profiles/shreddage-3-hydra.json",
  "piano_profile":  "profiles/virtual-pianist.json",

  "sections": [
    {
      // Four bars on the five chord, which is how half of these start.
      "name": "intro", "bars": 4, "intensity": 0.35,
      "feel": "straight", "plays": "drums+bass+piano", "fill": "small",
      "chords": ["E7", "D7", "A7", "E7"],
      "bass": "eighths", "piano": "sparse", "lead": "piano"
    },
    {
      // A real twelve bar: four on the one, two on the four, two on the one,
      // then the turnaround. Written out rather than cycled, because the shape
      // is the point.
      "name": "verse1", "bars": 12, "intensity": 0.50,
      "feel": "straight", "plays": "full", "fill": "auto",
      "chords": ["A7", "A7", "A7", "A7", "D7", "D7", "A7", "A7", "E7", "D7", "A7", "E7"],
      "bass": "eighths", "guitar": "sparse", "guitar2": "fills", "piano": "driving", "lead": "piano"
    },
    {
      "name": "verse2", "bars": 12, "intensity": 0.58,
      "feel": "straight", "plays": "full", "fill": "auto",
      "chords": ["A7", "A7", "A7", "A7", "D7", "D7", "A7", "A7", "E7", "D7", "A7", "E7"],
      "bass": "eighths", "guitar": "sparse", "guitar2": "fills", "piano": "driving", "lead": "piano"
    },
    {
      // The guitar takes a chorus, which in blues means twelve bars of its own -
      // and "solo" means it stops comping and plays a line. A player does one or
      // the other, never both, so the piano holds the harmony underneath.
      "name": "solo", "bars": 12, "intensity": 0.80,
      "feel": "straight", "plays": "full", "fill": "auto",
      "chords": ["A7", "A7", "A7", "A7", "D7", "D7", "A7", "A7", "E7", "D7", "A7", "E7"],
      "bass": "eighths", "guitar": "driving", "guitar2": "solo", "piano": "sparse", "lead": "guitar2"
    },
    {
      // Stop time: everything drops to accents on the one and the band leaves
      // holes. Half time gets closest to that with what the engine has.
      "name": "breakdown", "bars": 8, "intensity": 0.32,
      "feel": "half_time", "plays": "drums+bass+piano", "fill": "big",
      "chords": ["A7", "A7", "D7", "D7", "A7", "A7", "E7", "E7"],
      "bass": "roots", "piano": "sparse", "lead": "piano"
    },
    {
      "name": "verse3", "bars": 12, "intensity": 0.72,
      "feel": "straight", "plays": "full", "fill": "auto",
      "chords": ["A7", "A7", "A7", "A7", "D7", "D7", "A7", "A7", "E7", "D7", "A7", "E7"],
      "bass": "eighths", "guitar": "driving", "guitar2": "fills", "piano": "driving", "lead": "both"
    },
    {
      // Turnaround, and it slows to a stop.
      "name": "ending", "bars": 4, "intensity": 0.60,
      "feel": "straight", "plays": "full", "fill": "none",
      "chords": ["E7", "D7", "A7", "E7"],
      "guitar": "open", "guitar2": "silent", "piano": "open", "lead": "both"
    }
  ]
}
