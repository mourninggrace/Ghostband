{
  // A song whose only job is to get Shreddage in front of the Calibrate screen.
  //
  // It puts Shreddage in the GUITAR slot, which is what exposed the channel bug:
  // the slot's channel used to override the profile's, so this sent Shreddage's
  // notes and its articulation keyswitches to whatever else sat on channel 2.
  // Channels follow the instrument now, so this plays Shreddage on 11 and IRON 2
  // hears nothing at all. Prefer preset-twin-guitar for listening - it has both
  // guitars doing their own job.
  //
  // Calibrate walks whatever the loaded plan names, so a plan has to point at
  // the profile before its range can be checked. This is preset-thrash with the
  // guitar swapped, which means the solo section is already a real lead line to
  // listen to rather than block chords.
  //
  // Delete it once Shreddage has a verified profile and a home in a real song.
  // TERMINAL VELOCITY - thrash.
  //
  // Fast, tight and in Phrygian, which is where the flattened second that
  // makes metal sound like metal lives. Humanize is deliberately low: a thrash
  // band is judged on being locked together, and the looseness that flatters a
  // rock song makes this one sound sloppy.
  //
  // The piano is not a thrash instrument and is used as one texture rather than
  // a member of the band: it opens the song alone and returns in the breakdown,
  // and is otherwise silent. The guitar leads everywhere it plays.

  "title": "CAL Terminal Velocity",

  "key":  "D",
  "mode": "phrygian",
  "bpm":  184,
  "time_signature": [4, 4],

  "style":       "thrash",
  "bass_tuning": "b_standard",
  "play_style":  "pick",

  "complexity": 0.80,
  "humanize":   0.28,
  "seed":       6612,
  "ending":     "hard_stop",

  "drum_profile":   "profiles/ssd5-terry-date.json",
  "bass_profile":   "profiles/modo-bass-2.json",
  "guitar_profile": "profiles/shreddage-3-hydra.json",
  "piano_profile":  "profiles/virtual-pianist.json",

  "sections": [
    {
      // Alone, quiet, and in no hurry - so that what follows lands.
      "name": "intro", "bars": 4, "intensity": 0.20,
      "feel": "straight", "plays": "piano", "fill": "none",
      "chords": ["Dm"], "piano": "sparse", "lead": "piano"
    },
    {
      "name": "riff", "bars": 8, "intensity": 0.72,
      "feel": "double_time", "plays": "drums+bass+guitar", "fill": "big",
      "chords": ["Dm", "Dm", "Eb", "Dm"],
      "bass": "lock_kick", "guitar": "muted", "lead": "guitar"
    },
    {
      "name": "verse1", "bars": 8, "intensity": 0.62,
      "feel": "double_time", "plays": "drums+bass+guitar", "fill": "auto",
      "chords": ["Dm", "Dm", "Bb", "C"],
      "bass": "lock_kick", "guitar": "muted", "lead": "guitar"
    },
    {
      "name": "chorus1", "bars": 8, "intensity": 0.95,
      "feel": "straight", "plays": "drums+bass+guitar", "fill": "big",
      "chords": ["Bb", "C", "Dm", "Dm"],
      "bass": "eighths", "guitar": "driving", "lead": "guitar"
    },
    {
      "name": "verse2", "bars": 8, "intensity": 0.68,
      "feel": "double_time", "plays": "drums+bass+guitar", "fill": "auto",
      "chords": ["Dm", "Dm", "Bb", "C"],
      "bass": "lock_kick", "guitar": "muted", "lead": "guitar"
    },
    {
      "name": "chorus2", "bars": 8, "intensity": 0.98,
      "feel": "straight", "plays": "drums+bass+guitar", "fill": "big",
      "chords": ["Bb", "C", "Dm", "Dm"],
      "bass": "eighths", "guitar": "driving", "lead": "guitar"
    },
    {
      // Half the speed and twice the weight. The piano comes back here, low
      // and sparse, because the contrast is the point of a breakdown.
      "name": "breakdown", "bars": 8, "intensity": 0.55,
      "feel": "half_time", "plays": "full", "fill": "big",
      "chords": ["Dm", "Dm", "Dm", "Eb"],
      "bass": "lock_kick", "guitar": "muted", "piano": "sparse",
      "lead": "guitar"
    },
    {
      // The guitar actually solos here rather than comping through it. A
      // soloing part stops holding the harmony - one player, one pair of hands
      // - so this is bass and drums underneath, which is where a thrash solo
      // usually sits anyway. Straight feel, so the line can use sixteenths.
      "name": "solo", "bars": 12, "intensity": 0.92,
      "feel": "double_time", "plays": "drums+bass+guitar", "fill": "auto",
      "chords": ["Dm", "Bb", "C", "Dm", "Dm", "Eb", "C", "Dm",
                 "Bb", "C", "Dm", "Dm"],
      "bass": "eighths", "guitar": "solo", "lead": "guitar"
    },
    {
      "name": "chorus3", "bars": 8, "intensity": 1.0,
      "feel": "straight", "plays": "drums+bass+guitar", "fill": "big",
      "chords": ["Bb", "C", "Dm", "Dm"],
      "bass": "eighths", "guitar": "driving", "lead": "guitar"
    },
    {
      "name": "ending", "bars": 4, "intensity": 0.9,
      "feel": "double_time", "plays": "drums+bass+guitar", "fill": "none",
      "chords": ["Dm", "Eb", "Dm", "Dm"],
      "bass": "lock_kick", "guitar": "muted", "lead": "guitar"
    }
  ]
}
