{
  // The rock counterpart to demo-metal, and it had the same fault: it named a
  // drum and a bass profile and nothing else, so it played as drums and bass on
  // a machine with a full rig installed. Guitar and piano are opt-in - a part
  // with no profile named is never generated - so both are named here now.

  "title": "Ghostband Demo - Rock",

  "key":  "E",
  "mode": "natural_minor",
  "bpm":  96,
  "time_signature": [4, 4],

  "style":       "hard_rock",
  "bass_tuning": "standard",
  "play_style":  "pick",

  "complexity": 0.60,
  "humanize":   0.60,
  "seed":       1971,
  "ending":     "cymbal_ring",

  "drum_profile":   "profiles/mndst-drums.json",
  "bass_profile":   "profiles/modo-bass-2.json",
  "guitar_profile": "profiles/vg-iron2.json",
  "guitar2_profile": "profiles/shreddage-3-hydra.json",
  "piano_profile":  "profiles/virtual-pianist.json",

  // Unlike the metal plan, the piano earns a place through the whole song here.
  // "lead" hands the front of the arrangement back and forth: the guitar takes
  // the choruses, the piano takes verse 2 and the bridge, and whichever one is
  // not leading is thinned to long held chords underneath.

  "sections": [
