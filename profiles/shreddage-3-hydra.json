{
  // Impact Soundworks Shreddage 3 Hydra, hosted in Kontakt Player.
  //
  // NOTHING IN THIS FILE IS MEASURED YET. The probe cannot reach it: Shreddage
  // is a Kontakt library rather than a plugin, so loading Kontakt headlessly
  // gives an empty instance - the same wall as IRON 2 coming up in Player mode.
  // It has to be calibrated from inside the host, where Kontakt already has the
  // library loaded.
  //
  // THE RANGE. Hydra is an EIGHT string, tuned F#1 B1 E2 A2 D3 G3 B3 E4 at
  // concert pitch. Its lowest note is therefore around 30 and, with 24 frets on
  // the top string, its highest around 88. That is what is set below.
  //
  // It has not been confirmed by ear, but it is bracketed by something that has:
  // Shreddage's own keyswitch block. Kontakt's keyboard is labelled -2 to 8, so
  // C-2 is 0, and the articulation switches sit at 12 to 23 while Picking Mode
  // and Fretting Mode sit at 108 and 114. Anything Ghostband writes between 30
  // and 88 therefore cannot land on a keyswitch, which is the only mistake here
  // that does real damage - a note outside the sampled range is merely silent,
  // a note on a keyswitch changes how everything after it plays.
  //
  // KEYSWITCHES, read off the ARTICULATIONS page. Recorded here because they are
  // certain and worth not having to look up again, NOT because anything uses
  // them yet - see below.
  //
  //    12  C-1   Sustain              (velocity 1-119)
  //    13  C#-1  Mute
  //    14  D-1   Staccato
  //    15  D#-1  Power Chord Sustain
  //    16  E-1   Power Chord Mute
  //    17  F-1   Power Chord Staccato
  //    18  F#-1  Tremolo
  //    19  G-1   Choke
  //    20  G#-1  Tapping
  //    21  A-1   Harmonics
  //    23  B-1   FX
  //
  //    12  C-1   Pinch Harmonics      (same key, velocity 127 only)
  //    12  C-1   Rake                 (same key, velocity 120-126)
  //
  //     0  C-2   Force String
  //    10  Bb-2  Set Hand
  //   108  C7    Picking Mode
  //   114  F#7   Fretting Mode
  //
  // There is a second articulations page not yet read.
  //
  // NOTHING SENDS THESE YET. Ghostband only emits keyswitches for phrase-driven
  // instruments, where the keyswitch is the performance and is held down for the
  // length of it. Shreddage is a notes instrument whose keyswitches choose an
  // articulation alongside the notes - a different mechanism, and one the engine
  // does not have. Until it does, this plays sustains, which is whatever
  // articulation the instrument is left on.

  "name": "Shreddage 3 Hydra (Kontakt)",
  "id": "shreddage3_hydra",
  // Eleven. As the second guitar it cannot share channel 2 with the rhythm
  // guitar, and this is where the rig has it. If you use Shreddage as a song's
  // ONLY guitar, set the GUITAR channel to 11 in Settings, or it will be sent
  // notes on 2 and hear nothing.
  "channel": 11,

  "mode": "notes",

  "needs_verification": true,
  "verification_note": "Bends and legato confirmed by ear. The range is an eight-string guitar's, reasoned rather than measured - walk the Calibrate screen to confirm it.",

  "chord_zone": { "lowest_note": 30, "highest_note": 88 },

  // 119, not 127, and this one matters.
  //
  // Shreddage splits the Sustain keyswitch by velocity: 1-119 is a sustain,
  // 120-126 is a Rake, and 127 is a Pinch Harmonic. They are the same key, so
  // the only thing separating a played note from a rake is how hard it is hit.
  // The first version of this file capped at 120, which means Ghostband's
  // loudest accents - the landing note of every solo phrase, which is
  // deliberately the hardest hit in the line - would have come out as rakes.
  // That would have sounded like the library misbehaving rather than like a
  // number being one too high.
  "velocity_min": 45,
  "velocity_max": 119,

  // ---- articulation keyswitches ----
  //
  // Read off Shreddage's own ARTICULATIONS page, not guessed. A notes
  // instrument's keyswitch chooses HOW the notes it is sent will sound; it is
  // tapped rather than held, because these latch.
  //
  // Mapped to the section feel, which is the same vocabulary the rest of the
  // engine already speaks:
  //
  //   open    12  Sustain              ringing chords
  //   sparse  14  Staccato             short and spaced
  //   muted   13  Mute                 palm muted, the verse voice
  //   driving 15  Power Chord Sustain  the chorus riff
  //   busy    18  Tremolo              tremolo picking
  //   solo    12  Sustain              a lead line wants to ring, and legato
  //                                    needs a sustained note to hammer from
  //
  // "silent" is deliberately unmapped: there is no articulation for not
  // playing, and leaving the last one selected through a rest is correct.
  "phrases": {
    "open":    12,
    "sparse":  14,
    "muted":   13,
    "driving": 15,
    "busy":    18,
    "solo":    12
  },

  "keyswitches_verified": true,

  // 100, and this is not arbitrary.
  //
  // Shreddage splits the Sustain keyswitch by the velocity the KEY is pressed
  // at, exactly as it splits played notes: 1-119 selects Sustain, 120-126
  // selects Rake and 127 selects Pinch Harmonics. Press the articulation switch
  // too hard and the instrument selects a different articulation from the one
  // being asked for.
  "phrase_velocity": 100,

  // A lead line is one note at a time, so there is nothing to spread. Left at
  // zero rather than borrowed from the rhythm guitar profile, where nine ticks
  // of strum is what stops a chord sounding like a keyboard.
  "strum_ticks": 0,

  // Legato, and it needs no keyswitch at all.
  //
  // Shreddage's ARTICULATIONS page 2 lists Legato (Hammer/Pull) with velocity
  // 1-127 and no key against it: it is always armed and fires whenever a new
  // note is taken while the previous one is still sounding. Ghostband could not
  // produce that, because the lead renderer cut every note to end exactly where
  // the next began - so all 1616 notes of a song came out individually picked.
  //
  // Twelve ticks is about ten milliseconds at this tempo. Enough for the script
  // to see the overlap, far too little to hear as two notes at once. Bent notes
  // are excluded automatically; the wheel has to come home before the next note
  // starts.
  //
  // max_leap_semitones matches Shreddage's own hammer/pull range, which the
  // manual says defaults to two semitones - a wider interval will not trigger a
  // hammer-on however much it overlaps, so overlapping one buys nothing and
  // gives a monophonic instrument one more chance to steal its own voice.
  //
  // It matters for a second reason. Shreddage scales legato volume down until a
  // non-legato note is struck ("Realistic Volume", manual p22), so a run in
  // which every note is hammered fades away to nothing. Picking the leaps is
  // what resets it - which is also what a real player does when the hand moves.
  //
  // CONFIRMED BY EAR: the bends are audible and the legato flows, with the
  // settings below applied. What is still only reasoned is the range - the solo
  // plays across 34 to 87 without a hole, which is evidence but not proof that
  // 30 and 88 are the real ends.
  //
  // SETTINGS THIS EXPECTS IN SHREDDAGE, from the manual:
  //   Performance Style = Mono Lead (Mid/High)   "perfect for lead parts";
  //                       Standard plays low on the neck and prefers open strings
  //   Poly Input Latency = 0                     manual p11 recommends very low
  //                       or zero for fast parts, or the fretting jumps around
  //   Pitch Bend Range   = 2                     matches the bend block below
  "legato": { "overlap_ticks": 12, "max_leap_semitones": 2 },

  // Bends. Declared because this is a lead instrument and pitch bend is the
  // articulation Ghostband can send safely - it is a channel message rather
  // than a keyswitch, so the worst case is that nothing happens.
  //
  // range_semitones must match Shreddage's own wheel range. Two is the usual
  // default and what is assumed here; if the bends land short or sharp, that is
  // the number to correct, and Shreddage exposes it in its own interface.
  "bend": { "range_semitones": 2, "reach_semitones": 2, "ticks": 240 },

  // Vibrato, on the modwheel, which is where Shreddage takes it by default
  // (MAIN page, Vibrato Amount, gear icon - Controller: modwheel or aftertouch).
  //
  // The other half of the bend. A guitarist slides up into a note and then
  // shakes it; a held note that just sits there is the clearest sign nobody is
  // holding the instrument. It comes in after the bend has arrived rather than
  // with the attack, because vibrato from the attack sounds like an LFO.
  //
  // 90 rather than 127: full modwheel is a wobble, not a vibrato. Raise
  // Shreddage's own Vibrato Amount if you want more depth per unit of wheel.
  //
  // Set Mode to Fingered on that gear icon for the recorded vibrato samples;
  // Emulated is an LFO on the pitch and sounds like one.
  "vibrato": { "cc": 1, "depth": 90, "ticks": 160 },

  // ---- tone, and the hard limit on it ----
  //
  // Shreddage has TWO layers of controls and only one of them can be reached.
  //
  //   Shreddage Engine (the MAIN page)  - "virtually every knob can be MIDI
  //     learned", manual p7. Right-click the knob, move a CC.
  //
  //   Console (the amps, distortion, cabinets, EQ, delay - everything that
  //     makes a lead tone a lead tone) - CANNOT be automated or MIDI learned
  //     at all. From the Console manual's own FAQ: "The only way to make
  //     Console completely modular was to remove native automation / CC learn
  //     from the controls." The escape hatch it names is a Mod Matrix script,
  //     and Hydra does not have one.
  //
  // So Ghostband cannot switch Shreddage from a clean tone to a lead tone. What
  // it CAN do is push a fixed tone harder, which is what a guitarist does
  // anyway: the amp does not change for the solo, the playing hits it harder.
  //
  //   Volume          MAIN page, top left, under Tone & Signal. It is PRE-FX
  //                   gain, so raising it drives whatever amp is in Console
  //                   harder. This is the gain control, despite its name.
  //   Bite            MAIN page, right hand group. Adds brightness and takes
  //                   out low-mid body. Up for a solo, so the line cuts.
  //   Signal          the pickup selector: neck / neck+bridge / bridge. Neck is
  //                   round and vocal and is where leads live.
  //
  // NOT HERE, and deliberately - neither can be reached:
  //
  //   Multi-Tracking  four on/off toggles, not a knob. The manual says
  //                   "enabling the guitar of choice and disabling any other
  //                   guitars", and right-click MIDI learn does nothing on a
  //                   toggle - "virtually every KNOB" does not cover them.
  //                   Set by hand, once: ONE guitar for a lead patch, because
  //                   a doubled lead smears. It cannot change per section.
  //
  //   a level control  Nothing follows "level" here, so Ghostband falls back
  //                   to CC 7 for this part mix knob. That costs nothing and
  //                   may work outright. If it does not, the next route is
  //                   Kontakt own automation - and Console faders are never
  //                   an option, their CC learn having been removed to make
  //                   Console modular.
  //
  // All four follow "lead" - up, brighter, warmer and single-tracked when this
  // guitar is out front, back to the rhythm setting when it is not.
  //
  // THESE CC NUMBERS ARE ASSIGNED, NOT TAUGHT. Ghostband will send them and
  // Shreddage will ignore them until each knob is right-clicked and learned. A
  // CC nothing has learned does nothing, which is why declaring them is safe
  // where declaring a keyswitch would not be.
  //
  // For the mix knob, see "level" below: Console's faders cannot be learned, so
  // the volume that mix reaches has to be KONTAKT's instrument volume, assigned
  // from Kontakt's Automation tab - drag a MIDI CC onto the slider. That is not
  // a right-click, which is why right-clicking it did nothing.
  // NAMED AFTER THE KNOB YOU RIGHT-CLICK, not after what it does. The first
  // version called these drive/bite/pickup/tracks, and three of those four are
  // not written anywhere on Shreddage's interface - so the Settings list named
  // controls that appeared not to exist.
  //
  // VOLUME FOLLOWS "level", which is a change of mind and worth saying why.
  //
  // It followed "lead" - up when this guitar is out front - which is musically
  // the better use of a pre-FX gain and left NOTHING for the GTR 2 mix knob to
  // reach. The knob then fell back to CC 7, which Kontakt did not answer, so it
  // moved nothing at all. That is this project's own rule broken by its own
  // author: a control that does nothing is worse than no control.
  //
  // A working fader beats automated gain. Bite still follows "lead" and carries
  // most of that gesture anyway - a solo cuts through because it is brighter
  // more than because it is hotter.
  //
  // It is still pre-FX gain rather than an output level, so turning it down
  // makes the guitar cleaner as well as quieter. If that becomes a problem the
  // honest target is KONTAKT's instrument volume: its Automation tab, MIDI tab,
  // drag CC 20 onto the volume slider. That is a drag, not a right-click, which
  // is why right-clicking it did nothing.
  "controls": {
    "volume": { "cc": 20, "follows": "level", "type": "knob", "low": 0, "high": 1 },
    "bite": { "cc": 21, "follows": "lead", "type": "knob", "low": 0.15, "high": 0.7 },
    "signal": { "cc": 22, "follows": "lead", "type": "select", "positions": 3, "low": 1, "high": 0 },
    "xtra attack": { "cc": 23, "follows": "random", "type": "knob", "low": 0, "high": 1 },
    "pitch bend range": { "cc": 24, "follows": "none", "type": "knob", "low": 0, "high": 1 },
    "unison bend": { "cc": 25, "follows": "random", "type": "knob", "low": 0, "high": 1 },
    "tone": { "cc": 26, "follows": "random", "type": "knob", "low": 0, "high": 1 },
    "strumming mode": { "cc": 27, "follows": "none", "type": "switch", "low": 0, "high": 1 },
    "MIDI guitar mode": { "cc": 28, "follows": "none", "type": "switch", "low": 0, "high": 1 },
    "invert MIDI channels": { "cc": 29, "follows": "none", "type": "switch", "low": 0, "high": 1 },
    "anti-repetition": { "cc": 30, "follows": "none", "type": "switch", "low": 0, "high": 1 }
  }
}
