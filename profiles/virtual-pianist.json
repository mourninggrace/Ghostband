{
  // Written by Ghostband. Control mappings were made in the plugin.

  "name": "UJAM Virtual Pianist",
  "id": "virtual_pianist",
  "channel": 3,

  "mode": "notes",

  // Cleared 2026-09-07: the top of the range was walked on the Calibrate
  // screen and corrected (). The flag survived that only because saving a
  // calibration never cleared it - so the song screen went on warning about a
  // profile that had just been checked by hand, which is how a warning stops
  // being read.
  "needs_verification": false,
  "verification_note": "Requires Virtual Pianist set to Instrument mode, not Player mode.",

  // TOP OF THE RANGE CALIBRATED BY EAR, 2026-09-07: 72 -> 95.
  //
  // Walked on the Calibrate screen by the person who owns the rig, which is
  // the only way this number can be found - the probe cannot reach a plugin
  // that will not sound in a headless host. It arrived in a commit whose
  // message described a different profile entirely, so it is written down
  // here where it belongs.
  "chord_zone": { "lowest_note": 48, "highest_note": 95 },

  "velocity_min": 55,
  "velocity_max": 110,
  "strum_ticks": 0,

  "controls": {
    "character": { "cc": 22, "follows": "random once", "type": "select", "positions": 5, "low": 0, "high": 1 },
    // "random once", not "random", for the same reason as the guitar's effects:
    // re-choosing a piano's TONE at every section boundary is not a performance
    // decision, it is the instrument changing underneath the player.
    "tone": { "cc": 23, "follows": "random once", "type": "knob", "low": 0, "high": 1 },
    "finisher": { "cc": 24, "follows": "fixed", "type": "switch", "low": 0, "high": 0 },
    "finisher selection": { "cc": 25, "follows": "random once", "type": "select", "positions": 45, "low": 0, "high": 1 },
    "ambience": { "cc": 26, "follows": "fixed", "type": "switch", "low": 1, "high": 1 },
    "ambience selection": { "cc": 27, "follows": "random once", "type": "select", "positions": 45, "low": 0, "high": 1 },
    "volume": { "cc": 28, "follows": "level", "type": "knob", "low": 0, "high": 1 },
    "dynamics": { "cc": 29, "follows": "intensity", "type": "knob", "low": 0, "high": 1 },
    "tune": { "cc": 30, "follows": "none", "type": "knob", "low": 0, "high": 1 },
    "ambience amount": { "cc": 31, "follows": "random once", "type": "knob", "low": 0, "high": 1 }
  }
}
