{
  // Written by Ghostband. Control mappings were made in the plugin.

  "name": "UJAM Virtual Pianist",
  "id": "virtual_pianist",
  "channel": 3,

  "mode": "notes",

  "needs_verification": true,
  "verification_note": "Requires Virtual Pianist set to Instrument mode, not Player mode.",

  "chord_zone": { "lowest_note": 48, "highest_note": 72 },

  "velocity_min": 55,
  "velocity_max": 110,
  "strum_ticks": 0,

  "controls": {
    "character": { "cc": 22, "follows": "random once", "type": "select", "positions": 5, "low": 0, "high": 1 },
    "tone": { "cc": 23, "follows": "random", "type": "knob", "low": 0, "high": 1 },
    "finisher": { "cc": 24, "follows": "fixed", "type": "switch", "low": 0, "high": 0 },
    "finisher selection": { "cc": 25, "follows": "random once", "type": "select", "positions": 45, "low": 0, "high": 1},
    "ambience": { "cc": 26, "follows": "fixed", "type": "switch", "low": 1, "high": 1 },
    "ambience selection": { "cc": 27, "follows": "random once", "type": "select", "positions": 45, "low": 0, "high": 1 },
    "volume": { "cc": 28, "follows": "level", "type": "knob", "low": 0, "high": 1},
    "dynamics": { "cc": 29, "follows": "intensity", "type": "knob", "low": 0, "high": 1 },
    "tune": { "cc": 30, "follows": "none", "type": "knob", "low": 0, "high": 1 }
  }
}
