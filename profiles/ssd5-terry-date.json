{
  // SHELVED, not deleted. Every song plays MINDst Drums as of 2026-09-06.
  //
  // SSD5 stays because it is the calibrated, verified kit that worked, and if
  // MINDst turns out to have problems the way back should be quick. It is:
  //
  //     SwitchDrums ssd5        then        Install.bat
  //
  // which rewrites the drum profile named in every song. The channel comes from
  // this file - 10 - so nothing in Settings needs touching either way.
  //
  // Why the change: SSD5 exposes exactly ONE named parameter, Bypass, and 2080
  // anonymous "MIDI CC n|m" slots. There is no volume for a host or for
  // Ghostband to reach by name, which is why its master volume resisted every
  // attempt for weeks - there was nothing there to map. MINDst names all 3588
  // of its parameters.
  // Calibrated in Ghostband on this machine, by ear.
  // Any note here was confirmed against the real plugin.

  "name": "SSD5 - Terry Date (calibrated)",
  "id": "ssd5_terry_date_calibrated",

  // All seven SSD5 profiles are the same plugin in the same rack, so a knob
  // taught on any one of them is taught for all of them.
  "instrument": "ssd5",
  "channel": 10,

  "needs_verification": false,

  "velocity_min": 22,
  "velocity_max": 127,

  "notes": {
    "kick": 36,
    "snare": 38,
    "sidestick": 37,
    "rimshot": 40,
    "hat_closed": 42,
    "hat_open": 46,
    "hat_pedal": 44,
    "ride": 51,
    "ride_bell": 53,
    "crash": 50,
    "crash2": 57,
    "china": 52,
    "splash": 55,
    "tom1": 48,
    "tom2": 47,
    "tom3": 43,
    "tom4": 41
  },

  // Controls mapped in the plugin: an instrument's own knobs, buttons and
  // switches, driven by the arrangement. Built in Settings, named by whoever
  // made them, and written back here by Save mappings.
  //
  // Map the instrument's volume with follows "level" and the mix knob on the
  // song screen will reach it. Without one, the mix knob falls back to CC 7,
  // which most instrument plugins ignore outright.
  "controls": {}
}
