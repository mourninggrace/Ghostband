{
  "name": "SSD5 - Terry Date (calibrated)",
  "id": "ssd5_terry_date_calibrated",

  // All seven SSD5 profiles are the same plugin in the same rack, so a knob
  // taught on any one of them is taught for all of them.
  "instrument": "ssd5",
  "channel": 10,

  // Its volume cannot be reached from outside. SSD5 exposes one named parameter
  // - Bypass - and 2080 anonymous "MIDI CC n|m" slots, its Map page will not
  // assign a volume CC, and it does not implement CC 7. Ghostband hides the
  // drum mix knob rather than offering one that does nothing; use a gain block
  // in the host.
  "volume_reachable": false,

  "needs_verification": false,

  "velocity_min": 22,
  "velocity_max": 127,

  "notes": {
    "kick": 36,
    "snare": 38,
    "sidestick": 37,
    "rimshot": 40,
    "hat_closed": 42,
    "hat_open": 46,
    "hat_pedal": 44,
    "ride": 51,
    "ride_bell": 53,
    "crash": 50,
    "crash2": 57,
    "china": 52,
    "splash": 55,
    "tom1": 48,
    "tom2": 47,
    "tom3": 43,
    "tom4": 41
  },

  // Controls mapped in the plugin: an instrument's own knobs, buttons and
  // switches, driven by the arrangement. Built in Settings, named by whoever
  // made them, and written back here by Save mappings.
  //
  // Map the instrument's volume with follows "level" and the mix knob on the
  // song screen will reach it. Without one, the mix knob falls back to CC 7,
  // which most instrument plugins ignore outright.
  "controls": {}
}
