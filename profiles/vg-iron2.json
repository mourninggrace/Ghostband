{
  // UJAM Virtual Guitarist IRON 2 — INSTRUMENT MODE.
  //
  // IRON 2 has two modes and they need completely different driver profiles:
  //
  //   Instrument mode (this file) — it plays the notes you send it, like any
  //     other instrument. Ghostband voices the chords itself. Predictable, and
  //     it gives the arrangement real control over what is played.
  //
  //   Player mode (profiles/vg-iron2-player.json) — you hold a chord in a low
  //     key zone and hold a key in a phrase zone, and IRON 2 performs a riff.
  //     The playing is better, because a real guitarist recorded it, but
  //     Ghostband only gets to choose which phrase.
  //
  // Set the plugin to Instrument mode to use this file. If you switch IRON 2 to
  // Player mode, point the plan at the player profile instead - using the wrong
  // one sounds broken rather than merely wrong.
  //
  // RANGE, measured, and not what a guitar's range would suggest.
  //
  // The obvious choice was E2-E5 (40-64), an ordinary guitar range. That is
  // wrong: the probe measured IRON 2 as SILENT from 12 to 59 and sounding from
  // 60 to 89, and sending it notes at 40-57 produced visible MIDI activity and
  // no sound at all - reported as "I can see signals going to the guitar, but no
  // sound". Whatever the keyboard looks like, 60-89 is where it speaks.

  "name": "UJAM VG IRON 2 (instrument mode)",
  "id": "vg_iron2_instrument",
  "channel": 2,

  "mode": "notes",

  // Cleared 2026-09-07: the top of the range was walked on the Calibrate
  // screen and corrected (). The flag survived that only because saving a
  // calibration never cleared it - so the song screen went on warning about a
  // profile that had just been checked by hand, which is how a warning stops
  // being read.
  "needs_verification": false,
  "verification_note": "Requires IRON 2 set to Instrument mode, not Player mode.",

  // TOP OF THE RANGE CALIBRATED BY EAR, 2026-09-07: 84 -> 89.
  //
  // Walked on the Calibrate screen by the person who owns the rig, which is
  // the only way this number can be found - the probe cannot reach a plugin
  // that will not sound in a headless host. It arrived in a commit whose
  // message described a different profile entirely, so it is written down
  // here where it belongs.
  "chord_zone": { "lowest_note": 60, "highest_note": 89 },

  // Notes of a chord are struck a few milliseconds apart, alternating direction.
  // A real guitarist never sounds them together, and simultaneous notes are most
  // of why a generated guitar part sounds like a keyboard.
  "strum_ticks": 9,

  // Bends. IRON 2 receives them - confirmed by ear and by its own wheel
  // indicator moving on the two bent notes in the thrash solo.
  //
  // Receipt is what was in doubt, and it proves the whole path: Ghostband ->
  // host -> instrument. Whether IRON 2 applies the wheel to pitch as fully as a
  // dedicated lead instrument would is a smaller question, and one that stops
  // mattering the moment there is a lead instrument to send it to. It exposes
  // no bend, vibrato or slide control among its parameters, so this was never
  // going to be visible from the parameter list - pitch bend is a MIDI message
  // rather than a parameter, and a sampler can honour it without saying so.
  //
  // A bend goes on the note a phrase lands on. The note sounds a tone flat and
  // the wheel carries it up to the written pitch, which is what a guitarist
  // does and what keeps the landing note on the chord.
  //
  // range_semitones must match the instrument's own wheel range - two is the
  // usual default, and a wrong value lands the bend short or sharp.
  "bend": { "range_semitones": 2, "reach_semitones": 2, "ticks": 240 },

  // Arrangement moves these as the song goes: more drive in a loud section,
  // brighter when the guitar is leading, effect in for a chorus or solo. They do
  // nothing until IRON 2 has been taught them - right-click a knob, choose MIDI
  // Learn, then press the matching button in Ghostband's Settings.
  // Deliberately empty: control mappings are built in the plugin, named by
  // whoever made them, and saved back here. A guessed list of knob names was
  // never going to match what an instrument actually has.
  //
  //   follows "intensity" - tracks how loud the section is
  //   follows "lead"      - up when this part leads, down when it supports
  //   follows "peaks"     - on for choruses and solos, off in quiet sections
  //   follows "rising"    - climbs across the whole song
  //   follows "fixed"     - parked at "low", for a knob that should not move
  "controls": {
    "drive": { "cc": 22, "follows": "intensity", "type": "knob", "low": 0, "high": 1 },
    // AMP BY GENRE, from UJAM's own Iron 2 presets (docs/research): 0 Metal,
    // .2 Crunch, .4 Cream, .6 Crisp, .8 Clean. Was "fixed" at 0 - the Metal amp
    // on every song, ballads included.
    "amp": { "cc": 23, "follows": "style", "type": "select", "positions": 6, "low": 0, "high": 1, "picks": { "metal,thrash,groove_metal,prog_metal": [0.0, 0.2], "doom,sludge": [0.0, 0.2, 0.4], "hard_rock": [0.2, 0.4, 0.6], "alt_rock,punk,emo": [0.2, 0.4, 0.6], "blues": [0.4, 0.6, 0.8], "ballad": [0.6, 0.8], "default": [0.2, 0.6] } },
    // GUITAR BY GENRE (UJAM presets): 0 Twang, .3333 Bite, .6667 Soft, 1 Fat.
    "character": { "cc": 24, "follows": "style", "type": "select", "positions": 4, "low": 0, "high": 1, "picks": { "metal,thrash,groove_metal,prog_metal": [0.0, 0.3333], "doom,sludge": [1.0, 0.3333], "hard_rock": [0.0, 0.3333], "alt_rock,punk,emo": [1.0, 0.3333, 0.0], "blues": [0.0, 0.6667], "ballad": [0.6667, 0.0], "default": [0.0, 0.3333] } },
    "pickup": { "cc": 25, "follows": "intensity", "type": "knob", "low": 0, "high": 1 },
    "tune": { "cc": 26, "follows": "none", "type": "knob", "low": 0, "high": 1 },
    // VARIANCE BY GENRE: the medians of UJAM's own presets per genre folder.
    // Was "fixed" at 0 - the bottom of the knob - on every song.
    "variance": { "cc": 27, "follows": "style", "type": "knob", "low": 0, "high": 1, "picks": { "metal,thrash,groove_metal,prog_metal": [0.35], "doom,sludge": [0.35], "hard_rock": [0.45], "alt_rock,punk,emo": [0.36], "blues": [0.47], "ballad": [0.42], "default": [0.35] } },
    // STOMP BOX AMOUNT BY GENRE (UJAM presets: metal ~0.6-0.75, classic rock
    // ~0.5, alt/punk ~0.55, pop ~0.4). Was "fixed" at 0.
    "amount": { "cc": 28, "follows": "style", "type": "knob", "low": 0, "high": 1, "picks": { "metal,thrash,groove_metal,prog_metal": [0.6, 0.75], "doom,sludge": [0.6, 0.75], "hard_rock": [0.5, 0.65], "alt_rock,punk,emo": [0.5, 0.6], "blues": [0.4, 0.5], "ballad": [0.35, 0.45], "default": [0.5] } },
    // THE STOMP BOX ON (the owner's map, 2026-10-03: CC29 is its on/off).
    // 311 of UJAM's 313 presets have it on; "fixed" at 0 had it OFF on every
    // song. A song approved with it off pins it off (plans, "sound").
    "stomp box": { "cc": 29, "follows": "fixed", "type": "switch", "low": 1, "high": 1 },
    // NO DICE ON EFFECTS (2026-10-03). These were "random once": every song
    // rolled one of the instrument's effects - 63 finishers on Iron 2, among
    // them 4 Bit, Demonizer, Stutter and Warm Octave Cloud (a pitched layer
    // that made the rhythm guitar sound like "wrong, flat, augmented
    // chords"). Now "none": the instrument plays the preset the owner chose.
    // Genre-picked effects come next, from UJAM's own genre presets.
    // FINISHER BY GENRE - the ones UJAM's rock/metal/pop presets use, never
    // the Electronic/Experimental ones (4 Bit, Demonizer, Stutter, Warm Octave
    // Cloud...). .1148 Compressor, .2459 Parallel Reamping, .3607 Saturize,
    // .4590 Warm Reamp, .5246 Concert Room, .5574 Delay 1/4, .5902 Delay 1/8,
    // .7049 Large Room, .7213 Medium Room, .9344 Slap Back, .9672 Spring
    // Reverb, .9836 Warm Reverb, 1 Warm Room.
    "finisher": { "cc": 30, "follows": "style", "type": "select", "positions": 62, "low": 0, "high": 1, "picks": { "metal,thrash,groove_metal,prog_metal": [0.1148, 0.459, 0.3607, 0.2459, 1.0, 0.7213], "doom,sludge": [0.459, 0.3607, 1.0, 0.7049], "hard_rock": [0.1148, 0.459, 0.3607, 1.0, 0.9344], "alt_rock,punk,emo": [1.0, 0.1148, 0.459, 0.7213, 0.5902], "blues": [0.9344, 0.9672, 1.0, 0.1148], "ballad": [0.5246, 0.9836, 1.0, 0.5574], "default": [1.0, 0.1148] } },
    // These four were "random", which re-chooses every section. Picking WHICH
    // effect once per song and then re-rolling how much of it every eight bars
    // is incoherent - the tone shifted under the same riff, and a take recalled
    // never quite sounded like the take you remembered. A guitarist does not
    // rewire their delay between the verse and the chorus.
    //
    // "random once" holds the choice for the whole song, so a take has ONE
    // guitar tone and two takes of the same song have different ones, which is
    // what a take is for. Notes are unaffected: every control draws from its
    // own RNG stream precisely so that changing one cannot move a single note.
    "finisher amount": { "cc": 31, "follows": "none", "type": "knob", "low": 0, "high": 1 },
    "width": { "cc": 32, "follows": "none", "type": "knob", "low": 0, "high": 1 },
    "focus": { "cc": 33, "follows": "none", "type": "knob", "low": 0, "high": 1 },
    "volume": { "cc": 34, "follows": "level", "type": "knob", "low": 0, "high": 1},
    "latch": { "cc": 35, "follows": "none", "type": "switch", "low": 0, "high": 1 },
    // WHICH PEDAL, BY GENRE (30 of them; the owner mapped it to CC36,
    // 2026-10-03). Only the drives, boosts, compressor and chorus UJAM's rock,
    // metal and pop presets use - never a wah, filter, LoFi, Reversinator,
    // Warp Delay. .1034 Booster, .1379 Chorus, .1724 Compressor, .3103
    // Distortion, .3793 Hard Distortion, .5862 Overdrive, .931 Warm Drive.
    "stomp box selection": { "cc": 36, "follows": "style", "type": "select", "positions": 30, "low": 0, "high": 1, "picks": { "metal,thrash,groove_metal,prog_metal": [0.3793, 0.1034, 0.3103, 0.5862], "doom,sludge": [0.3793, 0.3103, 0.1034, 0.5862], "hard_rock": [0.1034, 0.5862, 0.3103, 0.1724], "alt_rock,punk,emo": [0.931, 0.5862, 0.3103, 0.1034], "blues": [0.1034, 0.5862, 0.931, 0.1724], "ballad": [0.1724, 0.1379, 0.1034], "default": [0.1034, 0.5862] } }
  },

  "velocity_min": 70,
  "velocity_max": 120
}
