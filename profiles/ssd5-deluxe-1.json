{
  // SHELVED, not deleted. Every song plays MINDst Drums as of 2026-09-06.
  //
  // SSD5 stays because it is the calibrated, verified kit that worked, and if
  // MINDst turns out to have problems the way back should be quick. It is:
  //
  //     SwitchDrums ssd5        then        Install.bat
  //
  // which rewrites the drum profile named in every song. The channel comes from
  // this file - 10 - so nothing in Settings needs touching either way.
  //
  // Why the change: SSD5 exposes exactly ONE named parameter, Bypass, and 2080
  // anonymous "MIDI CC n|m" slots. There is no volume for a host or for
  // Ghostband to reach by name, which is why its master volume resisted every
  // attempt for weeks - there was nothing there to map. MINDst names all 3588
  // of its parameters.
  "inherits": "ssd5.json",

  "name": "SSD5 - Deluxe 1",
  "id": "ssd5_deluxe_1",

  // All seven SSD5 profiles are the same plugin in the same rack, so a knob
  // taught on any one of them is taught for all of them.
  "instrument": "ssd5",

  "needs_verification": true,
  "verification_note": "Inherits the unverified SSD5 base map. Calibrate before trusting it.",

  "notes": {}
}
