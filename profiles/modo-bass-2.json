{
  // IK Multimedia MODO Bass 2.
  //
  // The tuning ranges below are hard facts and can be trusted: a 4-string bass in
  // standard tuning bottoms out at E1 = MIDI 28, drop D at 26, drop C at 24, and
  // B standard at 23. Ghostband uses these to decide how low a riff can sit, so
  // getting them right is what makes a drop tuning actually sound dropped.
  //
  // The ARTICULATIONS are a different matter. MODO Bass 2 lets you assign
  // keyswitches and controllers yourself on its Control page, so there is no
  // single correct answer - these are sensible defaults placed below the lowest
  // playable note so they can never collide with a riff, even in B standard.
  //
  // Run "ghostband calibrate", listen, and either point MODO at these numbers or
  // change these numbers to match MODO. Either direction works.

  "name": "MODO Bass 2",
  "id": "modo_bass_2",
  "channel": 1,

  "needs_verification": false,

  // The note range was found by ear and the articulations were read off
  // MODO's CONTROL page, so both are now facts rather than guesses.
  "articulations_verified": true,

  "velocity_min": 32,
  "velocity_max": 127,

  // Calibrated by ear against this rig: MODO's lowest sounding note is 40.
  //
  // That is an octave above where a four string bass's low E sits, and no
  // octave or transpose setting was found in MODO to explain it - so it is
  // simply where this setup's neck starts. It is the same 40 whatever the plan
  // says the bass is tuned to, because the floor belongs to MODO's key range
  // and not to Ghostband's idea of the tuning. Anything sent below it lights up
  // the fretboard off the end of the neck and makes no sound at all.
  "lowest_note": {
    "standard": 40,
    "drop_d": 40,
    "drop_c": 40,
    "b_standard": 40
  },
  "highest_note": 67,

  // Keyswitches need to land clear of the note they modify, never on the same
  // tick, or the plugin can apply them one note late.
  "keyswitch_lead_ticks": 30,
  "keyswitch_velocity": 100,

  // Read off MODO Bass 2's own CONTROL page, not guessed.
  //
  // MODO labels middle C as C3, so C1 is note 36 and every keyswitch on that
  // page lands below 40 - which is exactly where this rig's playable neck
  // starts. That is the check that confirms the octave reading: keyswitches sit
  // below the neck, notes sit on it.
  //
  //   MUTING           CC 9        (the mute is a controller, not a keyswitch)
  //   LEGATO SLIDE     CC 65
  //   HAM. ON/PULL OFF KS C0   24
  //   GHOST MODE       KS A#-1  22
  //   FORCE SLAP       KS C#-1  13
  //   FORCE PULL       KS D#-1  15
  //
  // The Latch column is the other half of it. MODO's playing styles latch, so a
  // brief press is enough; ghost, hammer, slide and the force switches show
  // Latch Off, meaning momentary - they only apply while the key is held, so
  // those are marked "hold" and stay down for the length of the note.
  //
  // Deliberately absent: the SLAP and PICK playing-style switches. Those latch,
  // so sending one would change the style for the rest of the song with nothing
  // to change it back. FORCE SLAP and FORCE PULL do the same job per note.
  "articulations": {
    "normal":    { "cc": 9,  "value": 0 },
    "palm_mute": { "cc": 9,  "value": 110 },

    "dead":      { "keyswitch": 22, "hold": true },
    "hammer":    { "keyswitch": 24, "hold": true },
    "slap":      { "keyswitch": 13, "hold": true },
    "pop":       { "keyswitch": 15, "hold": true },

    "slide":     { "cc": 65, "value": 127 }
  },

  // Controls mapped in the plugin: an instrument's own knobs, buttons and
  // switches, driven by the arrangement. Built in Settings, named by whoever
  // made them, and written back here by Save mappings.
  //
  // Map the instrument's volume with follows "level" and the mix knob on the
  // song screen will reach it. Without one, the mix knob falls back to CC 7,
  // which most instrument plugins ignore outright.
  "controls": {
    // MODO's MASTER VOLUME, which ships unassigned on its CONTROL page.
    // Assign it to CC 22 there and the bass mix knob on the song screen
    // reaches it directly - no gain block in the rackspace needed.
    //
    // CC 22 is free on both sides: MODO already uses 1, 2, 3, 4, 5, 9, 64 and
    // 65, and Ghostband never auto-assigns below 22.
    "volume": { "cc": 22, "follows": "level", "type": "knob", "low": 0, "high": 1 }
  }
}
